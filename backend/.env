# PostgreSQL ulanish manzili
# Mahalliy misol:    postgresql://postgres:parol@localhost:5432/dasta
# Supabase/Railway/Neon: ular bergan "connection string"ni shu yerga qo'ying
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vermond

# Ba'zi bulut provayderlar (Supabase, Neon) uchun SSL kerak bo'ladi.
# Kerak bo'lsa "true" qiling, mahalliy Postgres uchun odatda "false".
DATABASE_SSL=false

# Admin panel paroli — endi bu qiymat serverda turadi, brauzerda emas
ADMIN_PASSWORD=dasta2026

# JWT (token) imzolash uchun maxfiy kalit — buni ixtiyoriy uzun tasodifiy
# satrga o'zgartiring (masalan: openssl rand -hex 32)
JWT_SECRET=o-zgartiring-buni-tasodifiy-uzun-satrga

# Server porti
PORT=4000

# Frontend qaysi manzildan so'rov yuboradi (CORS uchun). Local ishlatsangiz
# Live Server odatda 5500-portda ishlaydi.
FRONTEND_ORIGIN=http://localhost:5500
