# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vermont_db

# Set true for hosted PostgreSQL providers that require SSL
DATABASE_SSL=false

# Admin credentials (change these outside local development)
ADMIN_PASSWORD=change-this-admin-password
JWT_SECRET=change-this-to-a-long-random-secret

PORT=4000
FRONTEND_ORIGIN=http://localhost:5500
